{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbitfabric.dev/contracts/scenario-projection-accounting-0.1-candidate.schema.json",
  "title": "Scenario Projection Accounting 0.1-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "accounting_version",
    "scenario",
    "completeness",
    "records"
  ],
  "properties": {
    "kind": {
      "const": "orbitfabric.scenario_projection_accounting"
    },
    "accounting_version": {
      "const": "0.1-candidate"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "completeness": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "reason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/identifier"
        }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_id",
        "disposition",
        "mapping_ids"
      ],
      "properties": {
        "atom_id": {
          "$ref": "#/$defs/identifier"
        },
        "disposition": {
          "enum": [
            "projected",
            "not_projected",
            "unsupported"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        },
        "mapping_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "not_projected",
                  "unsupported"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "$ref": "#/$defs/identifier"
              },
              "mapping_ids": {
                "maxItems": 0,
                "type": "array"
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "completeness": {
            "const": "partial"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  ]
}
