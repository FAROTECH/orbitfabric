{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbitfabric.dev/contracts/adapter-release-descriptor-0.1-candidate.schema.json",
  "title": "OrbitFabric Adapter Release Descriptor 0.1-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "descriptor_version",
    "source_coordinate",
    "release_version",
    "artifacts",
    "integration_package"
  ],
  "properties": {
    "kind": {"const": "orbitfabric.adapter_release"},
    "descriptor_version": {"const": "0.1-candidate"},
    "source_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "publisher", "name"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "release_version": {"type": "string", "minLength": 1},
    "source_provenance": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "artifact_type", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size": {"type": "integer", "minimum": 0},
          "selectors": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        }
      }
    },
    "integration_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
