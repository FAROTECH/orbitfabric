{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbitfabric.dev/contracts/evidence-set-manifest-0.1-candidate.schema.json",
  "title": "OrbitFabric Evidence Set Manifest 0.1-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "manifest_version", "evidence_set", "curator", "records"],
  "properties": {
    "kind": {"const": "orbitfabric.evidence_set_manifest"},
    "manifest_version": {"const": "0.1-candidate"},
    "evidence_set": {"$ref": "#/$defs/logicalIdentity"},
    "curator": {"$ref": "#/$defs/productIdentity"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceRecord"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableNonEmptyString": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "logicalIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "productIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "revision"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nullableNonEmptyString"},
        "revision": {"$ref": "#/$defs/nullableNonEmptyString"}
      }
    },
    "contentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\]+$"
        },
        "media_type": {"$ref": "#/$defs/nullableNonEmptyString"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contentDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "format_version", "producer", "reference"],
      "properties": {
        "kind": {"$ref": "#/$defs/nonEmptyString"},
        "format_version": {"$ref": "#/$defs/nullableNonEmptyString"},
        "producer": {"$ref": "#/$defs/productIdentity"},
        "reference": {"$ref": "#/$defs/contentReference"}
      }
    },
    "scenarioSourceSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scenario_id", "scenario_sha256"],
      "properties": {
        "type": {"const": "scenario_source"},
        "scenario_id": {"$ref": "#/$defs/nonEmptyString"},
        "scenario_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scenarioAtomSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scenario_sha256", "atom_id"],
      "properties": {
        "type": {"const": "scenario_atom"},
        "scenario_sha256": {"$ref": "#/$defs/sha256"},
        "atom_id": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "integrationResultSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "result_sha256"],
      "properties": {
        "type": {"const": "integration_result"},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "integrationMappingSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "result_sha256", "mapping_id"],
      "properties": {
        "type": {"const": "integration_mapping"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_id": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "integrationArtifactSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "result_sha256", "artifact_id"],
      "properties": {
        "type": {"const": "integration_artifact"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_id": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "subject": {
      "oneOf": [
        {"$ref": "#/$defs/scenarioSourceSubject"},
        {"$ref": "#/$defs/scenarioAtomSubject"},
        {"$ref": "#/$defs/integrationResultSubject"},
        {"$ref": "#/$defs/integrationMappingSubject"},
        {"$ref": "#/$defs/integrationArtifactSubject"}
      ]
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content", "subjects"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "content": {"$ref": "#/$defs/contentDescriptor"},
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/subject"}
        }
      }
    }
  }
}
